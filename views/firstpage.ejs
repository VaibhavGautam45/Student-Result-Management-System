<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> Student Result Management System</title>
  
  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

</head>

<style>

b{
  font-size: 28px;
  text-transform: uppercase;
  font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
}
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #020617, #212726);;
      animation: gradientMove 10s ease infinite;
      height: 100vh;
    }

    .overlay {
      backdrop-filter: blur(8px);
      height: 100vh;
      padding-top: 40px;
    }

    .navbar {
      /* background: rgba(245, 245, 245, 0.1); */
      backdrop-filter: blur(10px);
    }

    .navbar-brand {
      color: white !important;
      font-weight: bold;
    }

    .hero {
      text-align: center;
      color: white;
      margin-bottom: 50px;
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
    }

    .hero p {
      opacity: 0.9;
    }

    .card-box {
      background: rgba(255,255,255,0.15);
      border-radius: 25px;
      padding: 30px;
      text-align: center;
      color: white;
      backdrop-filter: blur(12px);
      transition: all 0.3s ease;
      border: 1px solid rgba(255,255,255,0.2);
    }

    .card-box:hover {
      transform: translateY(-10px) scale(1.03);
      box-shadow: 0 15px 30px rgba(0,0,0,0.3);
    }

    .icon {
      font-size: 50px;
      margin-bottom: 15px;
    }

    .btn-custom {
      border-radius: 50px;
      padding: 10px 25px;
      font-weight: 500;
    }

    .footer {
      position: absolute;
      bottom: 10px;
      width: 100%;
      text-align: center;
      color: white;
      opacity: 0.7;
      font-size: 14px;
    }
 </style>

<body>
<div class="overlay">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="#">🎓 SRMS</a>
    </div>
  </nav>

  <!-- Hero Section -->
  <div class="container hero">
    <h1>Student Result Management System</h1>
    <p>Manage Students, Results & Performance in a Smart Way</p>
  </div>

  <!-- Cards -->
  <div class="container">
    <div class="row justify-content-center g-4">

      <div class="col-md-3">
        <div class="card-box">
          <div class="icon"><i class="bi bi-person-circle"></i></div>
          <h5>Student Login</h5>
          <a href="/student/login" class="btn btn-light btn-custom mt-3">Enter</a>
        </div>
      </div>

      <div class="col-md-3">
        <div class="card-box">
          <div class="icon"><i class="bi bi-person-plus"></i></div>
          <h5>Student Signup</h5>
          <a href="/student/register" class="btn btn-success btn-custom mt-3">Register</a>
        </div>
      </div>

      <div class="col-md-3">
        <div class="card-box">
          <div class="icon"><i class="bi bi-shield-lock"></i></div>
          <h5>Admin Login</h5>
          <a href="/admin/login" class="btn btn-danger btn-custom mt-3">Admin Panel</a>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer -->
  <div class="footer">
    © 2026 Student Result Management System | Built with ❤️ by <b>Vaibhav</b> and <b>Vivekanand</b>  
  </div>

</div>

</body>
</html>
