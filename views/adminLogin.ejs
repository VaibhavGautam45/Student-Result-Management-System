<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

</head>
<body class="bg-gradient-to-r from-gray-900 via-gray-800 to-black h-screen flex items-center justify-center">

  <div class="bg-white/10 backdrop-blur-lg p-8 rounded-2xl shadow-2xl w-[350px] text-white">
    
    <h2 class="text-2xl font-bold text-center mb-6">🔐 Admin Login</h2>

    <form action="/admin/login" method="POST" class="space-y-4">
      
      <div>
        <label class="text-sm">Email</label>
        <input 
          type="email" 
          name="email"
          placeholder="Enter email"
          class="w-full mt-1 px-4 py-2 rounded-lg bg-white/20 focus:outline-none focus:ring-2 focus:ring-white text-white placeholder-gray-200"
          required>
      </div>

      <div>
        <label class="text-sm">Password</label>
        <input 
          type="password" 
          name="password"
          placeholder="Enter password"
          class="w-full mt-1 px-4 py-2 rounded-lg bg-white/20 focus:outline-none focus:ring-2 focus:ring-white text-white placeholder-gray-200"
          required>
      </div>

      <button 
        type="submit"
        class="w-full bg-white text-purple-600 font-semibold py-2 rounded-lg hover:bg-gray-200 transition">
        Login
      </button>

    </form>

    <a href="/" class="block text-center mt-4 text-sm text-gray-200 hover:text-white">
      ⬅ Back to Home
    </a>

  </div>

</body>
</html>