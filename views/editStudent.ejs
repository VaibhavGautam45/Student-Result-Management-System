<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Edit Student</h1>

<form action="/students/edit/<%= student._id %>" method="POST">

  <input type="text" name="name" value="<%= student.name %>" />
  <input type="text" name="rollNumber" value="<%= student.rollNumber %>" />

  <h3>Marks</h3>

  <% student.results.forEach((r, index) => { %>
    <div>
      <input type="text" name="subject" value="<%= r.subject %>" readonly />
      <input type="number" name="marks" value="<%= r.marks %>" />
    </div>
  <% }) %>

  <button type="submit">Update</button>
</form>
</body>
</html>