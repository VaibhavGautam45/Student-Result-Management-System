<!DOCTYPE html>
<html>
<head>
  <title>Student Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-gradient-to-br from-[#1e1e2f] to-[#0f172a] text-white min-h-screen p-8">

<div class="max-w-6xl mx-auto">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold">🎓 Student Dashboard</h1>

    <a href="/student/<%= user.rollNumber %>/pdf"
      class="px-5 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg shadow">
      📄 Download Report
    </a>
  </div>

  <!-- PROFILE -->
  <div class="bg-gray-900 p-6 rounded-2xl shadow-lg mb-6 flex justify-between">
    <div>
      <p class="text-xl font-semibold">👤 <%= user.name %></p>
      <p class="text-gray-400">Roll No: <%= user.rollNumber %></p>
    </div>

    <div class="text-right">
      <p class="text-gray-400">🏆 Class Rank</p>
      <h2 class="text-3xl font-bold text-yellow-400"><%= rank %></h2>
    </div>
  </div>

  <!-- INSIGHT CARDS -->
  <div class="grid grid-cols-4 gap-5 mb-6">

    <div class="bg-gray-900 p-5 rounded-xl shadow">
      <p class="text-gray-400">Average</p>
      <h2 class="text-2xl font-bold"><%= avg.toFixed(2) %></h2>
    </div>

    <div class="bg-gray-900 p-5 rounded-xl shadow">
      <p class="text-gray-400">Prediction</p>
      <h2 class="text-2xl text-blue-400 font-bold"><%= status %></h2>
    </div>

    <div class="bg-gray-900 p-5 rounded-xl shadow">
      <p class="text-gray-400">Risk</p>
      <h2 class="
        text-2xl font-bold
         <%= risk==='HIGH'?'text-red-500':
            risk==='MEDIUM'?'text-yellow-400':'text-green-400' %>
      ">
         <%= risk %>
      </h2>
    </div>

    <div class="bg-gray-900 p-5 rounded-xl shadow">
      <p class="text-gray-400">Subjects</p>
      <h2 class="text-2xl font-bold"><%= graded.length %></h2>
    </div>

  </div>

  <!-- RESULT TABLE -->
  <div class="bg-gray-900 p-6 rounded-2xl shadow-lg mb-6">
    <h2 class="text-xl font-semibold mb-4">📚 Results</h2>

    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-700 text-gray-400">
          <th class="py-2">Subject</th>
          <th>Marks</th>
          <th>Grade</th>
        </tr>
      </thead>
        
      <tbody>
        <% graded.forEach(r => { %>
          <tr class="border-b border-gray-800 hover:bg-gray-800 transition">
            <td class="py-2"><%= r.subject %></td>
            <td><%= r.marks %></td>

            <td class="
              font-bold
              <%= r.grade==='A'?'text-green-400':
                  r.grade==='B'?'text-blue-400':
                  r.grade==='C'?'text-yellow-400':'text-red-500' %>
            ">
              <%= r.grade %>
            </td>
          </tr>
        <% }) %>
    
      </tbody>
    </table>
  </div>

  <!-- CHART -->
  <div class="bg-gray-900 p-6 rounded-2xl shadow-lg">
    <h2 class="text-xl font-semibold mb-4">📊 Performance Chart</h2>
    <canvas id="chart"></canvas>
  </div>

</div>

<script>
const ctx = document.getElementById('chart');

new Chart(ctx, {
  type: 'bar',
  data: {
    labels: <%- JSON.stringify((graded || []).map(r => r.subject)) %>,
    datasets: [{
      label: 'Marks',
      data: <%- JSON.stringify((graded || []).map(r => r.marks)) %>,
      borderRadius: 8
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        labels: { color: 'white' }
      }
    },
    scales: {
      x: { ticks: { color: 'white' } },
      y: { ticks: { color: 'white' } }
    }
  }
});

</script>

</body>
</html>